<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_daily_log" model="ir.ui.view">
        <field name="name">project.task.form.inherit.daily.log</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <field name="has_quantified_subtasks" invisible="1"/>
                <field name="is_project_manager" invisible="1"/>
            </xpath>
            
            <!-- Add start_date, end_date, and completed_date to main form -->
            <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="completed_date" 
                       readonly="state != '1_done'" 
                       required="state == '1_done'"
                       decoration-success="completed_date and state == '1_done'"
                       placeholder="Fill when marking as done..."/>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Daily Log" name="daily_log">
                    <field name="daily_log_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="description"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']//field[@name='child_ids']//list//field[@name='name']" position="after">
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="completed_date" optional="show" required="state == '1_done'"/>
                <field name="quantification_type" widget="radio" options="{'horizontal': true}"/>
                <field name="target_no" string="Planned" 
                       invisible="quantification_type != 'quantified'"/>
                <field name="actual_no" string="Achieved" 
                       invisible="quantification_type != 'quantified'"/>
                <field name="variation_no" string="Variance" 
                       invisible="quantification_type != 'quantified'"/>
            </xpath>
            
        </field>
    </record>

    <!-- Quantification Report Tree View -->
    <record id="view_task_quantification_tree" model="ir.ui.view">
        <field name="name">project.task.quantification.tree</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="Quantification Report" create="false" edit="false" delete="false">
                <field name="name" string="Task Title"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="completed_date" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="parent_id" string="Parent Task" optional="show"/>
                <field name="user_ids" widget="many2many_tags" string="Assignees"/>
                <field name="target_no" string="Planned" sum="Total Planned"/>
                <field name="actual_no" string="Achieved" sum="Total Achieved"/>
                <field name="variation_no" string="Variance" sum="Total Variance" 
                       decoration-danger="variation_no &gt; 0" 
                       decoration-success="variation_no &lt;= 0"/>
                <field name="state" widget="badge" 
                       decoration-success="state == '1_done'"
                       decoration-info="state == '01_in_progress'"
                       decoration-warning="state == '04_waiting_normal'"
                       decoration-danger="state == '1_canceled'"/>
                <field name="quantification_type" widget="badge" 
                       decoration-info="quantification_type == 'quantified'"
                       decoration-muted="quantification_type == 'not_quantified'"/>
            </list>
        </field>
    </record>

    <!-- Quantification Report Pivot View -->
    <record id="view_task_quantification_pivot" model="ir.ui.view">
        <field name="name">project.task.quantification.pivot</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="Quantification Analysis" sample="1">
                <field name="project_id" type="row"/>
                <field name="parent_id" type="row"/>
                <field name="target_no" type="measure"/>
                <field name="actual_no" type="measure"/>
                <field name="variation_no" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Quantification Report Kanban View -->
    <record id="view_task_quantification_kanban" model="ir.ui.view">
        <field name="name">project.task.quantification.kanban</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" sample="1">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_ids"/>
                <field name="quantification_type"/>
                <field name="target_no"/>
                <field name="actual_no"/>
                <field name="variation_no"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                             <field name="name" class="fw-bold"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="project_id"/>
                            <div t-if="record.quantification_type.raw_value == 'quantified'">
                                <span>Planned: <field name="target_no"/></span> | 
                                <span>Achieved: <field name="actual_no"/></span>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom mt-auto d-flex justify-content-between align-items-center">
                            <field name="user_ids" widget="many2many_avatar_user"/>
                            <field name="state" widget="badge" options="{'classes': {'01_in_progress': 'info', '1_done': 'success', '04_waiting_normal': 'warning', '1_canceled': 'danger'}}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Quantification Report Search View -->
    <record id="view_task_quantification_search" model="ir.ui.view">
        <field name="name">project.task.quantification.search</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Task" name="group_by_task" context="{'group_by': 'name'}"/>
                <field name="parent_id"/>
                <filter string="Parent Task" name="group_by_parent" context="{'group_by': 'parent_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Quantification Report Action -->
    <record id="action_project_task_quantification_report" model="ir.actions.act_window">
        <field name="name">Quantification Report</field>
        <field name="res_model">project.task</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_project_id': 1, 'search_default_group_by_parent': 1}</field>
        <field name="view_mode">list,pivot,kanban,form</field>
        <field name="search_view_id" ref="view_task_quantification_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_task_quantification_tree')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_task_quantification_pivot')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_task_quantification_kanban')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks found
            </p>
            <p>
                Tasks and their quantification variance will appear here.
            </p>
        </field>
    </record>

    <!-- Quantification Report Menu Item -->
    <menuitem id="menu_project_task_quantification_report"
              name="Quantification Report"
              parent="project.menu_project_report"
              action="action_project_task_quantification_report"
              sequence="20"/>
</odoo>
